{
  "name": "nest-sentinel",
  "version": "0.2.1",
  "description": "NestJS port of ts-sentinel: rate limiting, API key auth, secure headers, request timeout, trace-id middleware, and input validation — idiomatic Nest guards/middleware/interceptors, reusing ts-sentinel's framework-agnostic core (validate, rate-limit token bucket) as a real dependency.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./validate": "./dist/validate/index.js",
    "./ratelimit": "./dist/ratelimit/index.js",
    "./auth": "./dist/auth/index.js",
    "./headers": "./dist/headers/index.js",
    "./resource": "./dist/resource/index.js",
    "./traceid": "./dist/traceid/index.js",
    "./auditlog": "./dist/auditlog/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arayaroma/nest-sentinel.git"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "express": "^4.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "express": "^4.19.0",
    "jest": "^30.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "supertest": "^7.1.3",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
